{{!
    @template tiny_polyglot/status

    Status line of the translation dialogue: a warning, the progress of the translation, or the errors.

    Context variables required for this template:
    * warning - Optional warning message.
    * progress - Optional progress message, shown with a spinner.
    * haserrors - Whether there are errors to show.
    * errors - Error messages.

    Example context (json):
    {
        "progress": "Translating to Español (es): 1 of 2",
        "haserrors": true,
        "errors": ["Français (fr): The AI service cannot be reached."]
    }
}}
{{#warning}}
<div class="alert alert-warning mb-0">{{warning}}</div>
{{/warning}}
{{#progress}}
<div class="d-flex align-items-center">
    <span class="spinner-border spinner-border-sm me-2 mr-2" aria-hidden="true"></span>
    <span>{{progress}}</span>
</div>
{{/progress}}
{{#haserrors}}
<div class="alert alert-danger mb-0">
    <ul class="mb-0">
        {{#errors}}<li>{{.}}</li>{{/errors}}
    </ul>
</div>
{{/haserrors}}
